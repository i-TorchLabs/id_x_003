# ===== 前端构建期注入（NEXT_PUBLIC_* 在 npm run build 时内联，client_secret 绝不可放这里） =====
# 业务站点 https 域名（resource 参数）
NEXT_PUBLIC_SITE_URL=https://sme-cloud.cuhk.edu.cn
# GraphQL 接口路径
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_SUB_VERSION=/b/id_x_003/graphql

# ===== ADFS OAuth2 授权码授予流（前端，仅公开信息） =====
# 大学统一身份认证系统分配的 Client ID（公开标识）
NEXT_PUBLIC_ADFS_CLIENT_ID=6044b8ba-3961-4931-83bc-4edd845e4983
# 回调地址：必须与 ADFS 注册地址、后端 AA_OAUTH_REDIRECT_URI 完全一致（https，区分大小写）
NEXT_PUBLIC_ADFS_REDIRECT_URI=https://sme-cloud.cuhk.edu.cn/f/003/oauth2
# resource 参数：自己业务的 https 域名（默认取 NEXT_PUBLIC_SITE_URL）
NEXT_PUBLIC_ADFS_RESOURCE=https://sme-cloud.cuhk.edu.cn
