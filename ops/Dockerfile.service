# id_x_003 后端服务镜像（构建上下文为仓库根目录）
FROM ghcr.io/astral-sh/uv:0.9-python3.10-bookworm-slim AS builder

WORKDIR /app/i-Box

# 仅安装生产依赖（pyproject.toml 作为 requirements 源，不构建项目本身）
COPY pyproject.toml ./
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/* \
    && uv pip install --system --no-cache -r pyproject.toml

FROM python:3.10-slim
WORKDIR /app/i-Box

# 运行时依赖：libpq（psycopg2）、curl（健康检查）
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -r -u 10001 -m appuser

COPY --from=builder /usr/local/lib/python3.10/site-packages /usr/local/lib/python3.10/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY main.py /app/i-Box/main.py
COPY src /app/i-Box/src
COPY utils /app/i-Box/utils
COPY config /app/i-Box/config
COPY x_models/_contracts /app/i-Box/x_models/_contracts
COPY x_models/id_x_003 /app/i-Box/x_models/id_x_003

RUN mkdir -p /app/i-Box/logs && chown -R appuser:appuser /app/i-Box

ENV PROJECT_PATH=/app/i-Box \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

USER appuser
EXPOSE 7000

HEALTHCHECK --interval=10s --timeout=5s --retries=12 --start-period=20s \
    CMD curl -fsS -o /dev/null -w '%{http_code}' http://127.0.0.1:7000/ | grep -qE '200|400|401|404'

CMD ["python", "main.py"]
