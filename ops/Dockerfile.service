FROM python:3.10-slim
WORKDIR /app/i-Torch
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*
COPY x_models/id_x_003/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY main.py /app/i-Torch/main.py
COPY src /app/i-Torch/src
COPY utils /app/i-Torch/utils
COPY config /app/i-Torch/config
COPY x_models/_contracts /app/i-Torch/x_models/_contracts
COPY x_models/id_x_003 /app/i-Torch/x_models/id_x_003
CMD ["python", "main.py"]
